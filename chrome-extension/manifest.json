{
  "manifest_version": 3,
  "name": "Image Pocket",
  "version": "1.0",
  "description": "Save images from the web to your semantic image search collection",  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],  "action": {
    "default_popup": "popup.html",
    "default_title": "Image Pocket"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}