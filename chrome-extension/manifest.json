{
  "manifest_version": 3,
  "name": "Image Pocket",
  "version": "1.0",
  "description": "Save images from any website to Vercel Blob storage",  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Image Pocket"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
